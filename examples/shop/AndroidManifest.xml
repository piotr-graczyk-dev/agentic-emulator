<?xml version="1.0" encoding="utf-8"?>
<!-- Agemu Shop: a small store app for agent benchmarks (examples/agent-race). Sign in, search,
     a scrolling catalog, a product page with a quantity stepper, a cart, a checkout form and a
     confirmation, with short simulated network delays. Built by examples/shop/build.sh without
     Gradle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.agemu.shop"
    android:versionCode="1"
    android:versionName="1.0">

    <application android:label="Agemu Shop" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".LoginActivity" android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".CatalogActivity" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ProductActivity" />
        <activity android:name=".CartActivity" />
        <activity android:name=".CheckoutActivity" android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ConfirmationActivity" />
    </application>
</manifest>
